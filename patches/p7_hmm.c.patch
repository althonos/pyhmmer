-  if (strcmp(h1->ctime,  h2->ctime)  != 0) return eslFAIL;
+  if (esl_strcmp(h1->ctime,  h2->ctime)  != 0) return eslFAIL;
 
   if (h1->nseq     != h2->nseq)                                      return eslFAIL;
   if (esl_FCompare_old(h1->eff_nseq, h2->eff_nseq, tol) != eslOK)        return eslFAIL;
