   if (hmm->ctime != NULL) free(hmm->ctime);
@@ -1198,7 +1198,7 @@ p7_hmm_Compare(P7_HMM *h1, P7_HMM *h2, float tol)
 
   if (strcmp(h1->name,   h2->name)   != 0) return eslFAIL;
